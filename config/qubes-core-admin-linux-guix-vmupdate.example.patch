+def write_current_generation_inputs(
+        tmp_path, current_source="(operating-system)\n",
+        configured_source=None):
+    if configured_source is None:
+        configured_source = (
+            ";; local comment before current configuration\n"
+            f"{current_source}"
+        )
+    Path(GUIXCLI.SYSTEM_CONFIG).write_text(configured_source,
+                                           encoding="ascii")
+    Path(GUIXCLI.CURRENT_SYSTEM).mkdir(parents=True, exist_ok=True)
+    Path(GUIXCLI.CURRENT_CONFIGURATION).write_text(current_source,
+                                                   encoding="ascii")
+
